+-- signal_radio patch: listen-only channels
+-- talkers we currently hear through a listen-only channel: [channel][talker] = true
+local listenedTalkers = {}
+
+RegisterNetEvent('pma-voice:syncRadioListeners', function(listeners)
+	radioListenerTargets = listeners
+	if radioPressed then
+		addVoiceTargets(radioData, radioListenerTargets, callData)
+	end
+end)
+
+RegisterNetEvent('pma-voice:addRadioListenerTarget', function(listener)
+	radioListenerTargets[listener] = true
+	if radioPressed then
+		addVoiceTargets(radioData, radioListenerTargets, callData)
+	end
+end)
+
+RegisterNetEvent('pma-voice:removeRadioListenerTarget', function(listener)
+	radioListenerTargets[listener] = nil
+	if radioPressed then
+		-- rebuild so the removed listener stops receiving this transmission now
+		MumbleClearVoiceTargetPlayers(voiceTarget)
+		addVoiceTargets(radioData, radioListenerTargets, callData)
+	end
+end)
+
+RegisterNetEvent('pma-voice:radioListenerTalking', function(channel, talker, talking)
+	listenedTalkers[channel] = listenedTalkers[channel] or {}
+	listenedTalkers[channel][talker] = talking or nil
+	if next(listenedTalkers[channel]) == nil then
+		listenedTalkers[channel] = nil
+	end
+	-- always process a stop, or a disable bit would leave the talker stuck on radio audio
+	if talking and not isRadioEnabled() then return end
+	setRadioTalkerVoice(talker, talking, channel)
+end)
+
+RegisterNetEvent('pma-voice:radioListenerRemoved', function(channel)
+	for talker, _ in pairs(listenedTalkers[channel] or {}) do
+		setRadioTalkerVoice(talker, false, channel)
+	end
+	listenedTalkers[channel] = nil
+end)
+
+--- Reapplies radio audio for every talker. Call it after the resolver's answers change,
+--- and after removing a disable bit, because pma-voice ignores talk events while a bit is set.
+function refreshRadioAudio()
+	if not isRadioEnabled() then
+		-- only process stops while a disable bit is held, as setTalkingOnRadio does
+		for tgt, _ in pairs(radioData) do
+			if tgt ~= playerServerId then
+				setRadioTalkerVoice(tgt, false)
+			end
+		end
+		return
+	end
+	handleRadioAndCallInit()
+	for channel, talkers in pairs(listenedTalkers) do
+		for talker, _ in pairs(talkers) do
+			toggleVoice(talker, true, 'radio', channel)
+		end
+	end
+end
+exports('refreshRadioAudio', refreshRadioAudio)
+
