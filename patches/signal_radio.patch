+-- signal_radio patch: listen-only channels
+-- radioListeners[channel][source] = { withAudio = boolean, owner = resource name }
+local radioListeners = {}
+
+local function getAudioListeners(channel)
+	local audioListeners = {}
+	for listener, data in pairs(radioListeners[channel] or {}) do
+		if data.withAudio then
+			audioListeners[listener] = true
+		end
+	end
+	return audioListeners
+end
+
+--- Tells a channel's listeners about a talk start or stop.
+--- Listeners without audio get channel activity only, never the talker's identity.
+local function notifyRadioListeners(channel, talker, talking)
+	local listeners = radioListeners[channel]
+	if not listeners then return end
+	local isTalking = talking and true or false
+	local active = isTalking
+	for _, memberTalking in pairs(radioData[channel] or {}) do
+		active = active or (memberTalking and true or false)
+	end
+	for listener, data in pairs(listeners) do
+		if data.withAudio then
+			TriggerClientEvent('pma-voice:radioListenerTalking', listener, channel, talker, isTalking)
+		else
+			TriggerClientEvent('pma-voice:radioListenerActivity', listener, channel, active)
+		end
+	end
+end
+
+--- removes a listen-only listener from a channel
+---@param source number the listener
+---@param channel number the channel they listen to
+---@return boolean wasRemoved
+local function removeRadioListener(source, channel)
+	local listeners = radioListeners[channel]
+	local data = listeners and listeners[source]
+	if not data then return false end
+	listeners[source] = nil
+	if next(listeners) == nil then
+		radioListeners[channel] = nil
+	end
+	if data.withAudio then
+		triggerEventForRadioChannel('pma-voice:removeRadioListenerTarget', radioData[channel] or {}, source)
+	end
+	TriggerClientEvent('pma-voice:radioListenerRemoved', source, channel)
+	return true
+end
+
+exports('removeRadioListener', removeRadioListener)
+
+--- adds a listen-only listener to a channel
+---@param source number the listener
+---@param channel number the channel to listen to
+---@param withAudio boolean true to hear voice, false to get talk events only
+---@return boolean wasAdded
+local function addRadioListener(source, channel, withAudio)
+	if GetConvarInt('voice_enableRadios', 1) ~= 1 then return false end
+	source, channel = tonumber(source), tonumber(channel)
+	if not source or not channel or channel <= 0 then
+		error("addRadioListener expected a numeric 'source' and a 'channel' above 0")
+	end
+	if not voiceData[source] or voiceData[source].radio == channel then return false end
+	withAudio = withAudio == true
+
+	local existing = radioListeners[channel] and radioListeners[channel][source]
+	if existing then
+		if existing.withAudio == withAudio then return true end
+		removeRadioListener(source, channel)
+	end
+
+	radioListeners[channel] = radioListeners[channel] or {}
+	radioListeners[channel][source] = { withAudio = withAudio, owner = GetInvokingResource() }
+	if withAudio then
+		triggerEventForRadioChannel('pma-voice:addRadioListenerTarget', radioData[channel] or {}, source)
+	end
+
+	-- catch the new listener up on a transmission already in progress
+	local active = false
+	for talker, talking in pairs(radioData[channel] or {}) do
+		if talking then
+			active = true
+			if withAudio then
+				TriggerClientEvent('pma-voice:radioListenerTalking', source, channel, talker, true)
+			end
+		end
+	end
+	if active and not withAudio then
+		TriggerClientEvent('pma-voice:radioListenerActivity', source, channel, true)
+	end
+	return true
+end
+
+exports('addRadioListener', addRadioListener)
+
