+-- signal_radio patch: per-talker radio audio
+local radioAudioResolver, radioAudioResolverOwner
+
+--- Registers a function that decides how each radio talker sounds.
+--- The function receives (talkerServerId, listenerChannel). listenerChannel is nil on the primary channel.
+--- It returns { submix = name, volume = 0.0 to 1.0 }, { proximity = true } for normal voice, or nil to mute.
+exports('setRadioAudioResolver', function(resolver)
+	radioAudioResolver = resolver
+	radioAudioResolverOwner = resolver and GetInvokingResource() or nil
+end)
+
+AddEventHandler('onClientResourceStop', function(resource)
+	if resource == radioAudioResolverOwner then
+		radioAudioResolver, radioAudioResolverOwner = nil, nil
+	end
+end)
+
+--- @return boolean applied false when pma-voice should use its default radio audio
+local function applyResolvedRadioAudio(plySource, listenerChannel)
+	local ok, audio = pcall(radioAudioResolver, plySource, listenerChannel)
+	if not ok then
+		logger.error('[radio] The radio audio resolver failed: %s', audio)
+		return false
+	end
+	if audio == nil then
+		MumbleSetVolumeOverrideByServerId(plySource, 0.0)
+		return true
+	end
+	if audio.proximity then
+		MumbleSetVolumeOverrideByServerId(plySource, -1.0)
+		restoreDefaultSubmix(plySource)
+		return true
+	end
+	local scale = math.max(0.0, math.min(1.0, tonumber(audio.volume) or 1.0))
+	MumbleSetVolumeOverrideByServerId(plySource, volumes['radio'] * scale)
+	if GetConvarInt('voice_enableSubmix', 1) == 1 then
+		disableSubmixReset[plySource] = true
+		local submixId = submixIndicies[audio.submix] or submixIndicies['radio']
+		if submixId then
+			MumbleSetSubmixForServerId(plySource, submixId)
+		end
+	end
+	return true
+end
